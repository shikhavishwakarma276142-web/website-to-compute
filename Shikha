# ---------- Login loader ----------
@login_manager.user_loader
def load_user(user_id):
    return User.query.get(int(user_id))

# ---------- Helpers ----------
def allowed_file(filename):
    return '.' in filename and filename.rsplit('.',1)[1].lower() in ALLOWED_EXT

def high_quality_write(clip, out_path):
    """
    Exports video with high-quality ffmpeg params.
    Using libx264, CRF ~18 (good quality), preset slow for better compression.
    """
    clip.write_videofile(
        out_path,
        codec='libx264',
        audio_codec='aac',
        temp_audiofile='temp-audio.m4a',
        remove_temp=True,
        threads=4,
        preset='slow',
        bitrate=None,
        ffmpeg_params=["-crf", "18", "-pix_fmt", "yuv420p"]
    )

# ---------- Templates (simple demo templates) ----------
def apply_template_trim_text(input_path, start, end, title_text):
    clip = VideoFileClip(input_path)
    duration = clip.duration
    if end <= 0 or end > duration:
        end = duration
    if start < 0:
        start = 0
    sub = clip.subclip(start, end)
    if title_text:
        txt = (TextClip(title_text, fontsize=60, font='Amiri-Bold')
               .set_duration(sub.duration)
               .set_position(("center", "top"))
               .set_opacity(0.9))
        final = CompositeVideoClip([sub, txt])
    else:
        final = sub
    return final

def apply_template_intro_merge(input_path, start, end, title_text):
    # Merge a short intro (static sample) + clip, color effect, overlay title
    intro_path = os.path.join(BASE_DIR, 'static', 'sample_media', 'intro.mp4')
    main_clip = VideoFileClip(input_path).subclip(start if start>0 else 0, end if end>0 else None)
    # If intro exists, append
    if os.path.exists(intro_path):
        intro = VideoFileClip(intro_path).resize(width=720)
        # apply a tint effect to clip
        main_clip = main_clip.fx(vfx.colorx, 1.05)
        combined = concatenate_videoclips([intro, main_clip])
    else:
        combined = main_clip
    if title_text:
        txt = (TextClip(title_text, fontsize=50, font='Amiri-Bold')
               .set_duration(4)
               .set_position(("center","bottom"))
               .set_opacity(0.9))
        final = CompositeVideoClip([combined, txt.set_start(2)])
    else:
        final = combined
    return final

def apply_template_caption(input_path, start, end, title_text):
    clip = VideoFileClip(input_path).subclip(start if start>0 else 0, end if end>0 else None)
    if title_text:
        caption = (TextClip(title_text, fontsize=40, font='Amiri-Bold', bg_color='rgba(0,0,0,0.3)')
                   .set_duration(clip.duration)
                   .set_position(("left","bottom")))
        final = CompositeVideoClip([clip, caption])
    else:
        final = clip
    return final

def apply_template_music_trim(input_path, start, end, title_text):
    clip = VideoFileClip(input_path).subclip(start if start>0 else 0, end if end>0 else None)
    music_path = os.path.join(BASE_DIR, 'static', 'sample_media', 'bg_music.mp3')
    if os.path.exists(music_path):
        bg = AudioFileClip(music_path).volumex(0.6)
        # loop bg if shorter than clip
        if bg.duration < clip.duration:
            # simple loop by concatenating:
            loops = int(clip.duration // bg.duration) + 1
            bg = concatenate_videoclips([bg.set_duration(bg.duration) for _ in range(loops)]).set_duration(clip.duration)
        clip = clip.set_audio(bg.set_duration(clip.duration))
    return clip

TEMPLATE_FUNCTIONS = {
    'trim_text': apply_template_trim_text,
    'intro_merge': apply_template_intro_merge,
    'caption_style': apply_template_caption,
    'music_trim': apply_template_music_trim
}

# ---------- Simple job queue (in-memory) ----------
JOB_LOCK = threading.Lock()
def process_video_job(video_id):
    """
    Background thread worker: processes the video according to selected template.
    Updates Video.status and output_filename in DB.
    """
    with app.app_context():
        video = Video.query.get(video_id)
        if not video:
            return
        try:
            video.status = 'processing'
            db.session.commit()
            input_path = os.path.join(app.config['UPLOAD_FOLDER'], video.stored_filename)
            out_name = f"out_{uuid.uuid4().hex}.mp4"
            out_path = os.path.join(app.config['OUTPUT_FOLDER'], out_name)

            # parse simple params stored in template field? For demo we assume start/end/title saved temporarily in filename
            # (In this demo, those params are passed as part of the stored_filename after '::' — simple hack)
            # Format: stored_filename is realfilename, but we saved metadata in DB in production. Here we assume defaults.
            start = 0.0
            end = 0.0
            title = video.template or ''

            # Choose template function
            template_key = video.template if video.template in TEMPLATE_FUNCTIONS else 'trim_text'
            func = TEMPLATE_FUNCTIONS[template_key]

            # Build clip and export
            clip = func(input_path, start, end, title)
            # High quality write
            high_quality_write(clip, out_path)

            # update DB
            video.output_filename = out_name
            video.status = 'done'
            db.session.commit()
        except Exception as e:
            video.status = 'error'
            video.error = str(e)
            db.session.commit()

